---
// Apple-style product page for one project: coloured hero with the live product, a screen that
// rises as you scroll, highlights, the numbers with their method, then the full case study (slot).
import Base from './Base.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import Highlights from '../components/Highlights.astro';
import Metric from '../components/Metric.astro';
import { projects, type Project } from '../data/projects';

interface Props {
  project: Project;
  title: string;
  facts: { label: string; value: string }[];
}
const { project: p, title, facts } = Astro.props;
const next = projects[(projects.indexOf(p) + 1) % projects.length];
const hue = `--g1: var(--${p.slug}); --g2: var(--${p.slug}-2); --ink-accent: var(--${p.slug}-ink)`;
// A low-resolution cover is shown at most 20% larger than it was captured, so it stays sharp.
const heroMax = p.cover.width < 1100 ? Math.round(p.cover.width * 1.2) : undefined;
---
<Base
  title={title}
  description={`${p.tagline}. ${p.problem}`}
  image={`/og/${p.slug}.png`}
  imageAlt={`${p.name}: ${p.tagline}. ${p.metrics.map((m) => `${m.value} ${m.label}`).join('; ')}.`}
  type="article">
  <section class={`p-hero p-hero-${p.slug}${p.theme === 'dark' ? ' grain' : ''}`} data-theme={p.theme} style={hue}>
    <div class="container p-hero-text intro">
      <a class="back" href="/work">← All work</a>
      <p class="eyebrow gradient-text">Case study · {p.period}</p>
      <h1 class="display">{p.name}</h1>
      <p class="lead p-tagline">{p.tagline}.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={p.live.url} target="_blank" rel="noopener" data-magnetic>{p.live.label} <span class="arrow">↗</span></a>
        {
          p.repo.private ? (
            <span class="repo-private" title="The source code is in a private GitHub repository">
              <span class="lock" aria-hidden="true" />
              Private repo · code walkthrough on request
            </span>
          ) : (
            <a class="btn btn-ghost" href={p.repo.url} target="_blank" rel="noopener">
              Source ↗
            </a>
          )
        }
      </div>
    </div>
    <div class="container-wide p-hero-media">
      <div data-rise style={heroMax ? `max-width: ${heroMax}px; margin-inline: auto` : undefined}>
        <BrowserFrame
          image={p.cover}
          alt={p.coverAlt}
          url={p.live.url}
          vt={`shot-${p.slug}`}
          ratio="16 / 9.6"
          position={p.coverPosition}
          dark={p.theme === 'dark'}
          priority
          sizes={heroMax ? `(max-width: ${heroMax}px) 94vw, ${heroMax}px` : '(max-width: 1440px) 94vw, 1340px'}
        />
      </div>
    </div>
  </section>

  <section class="section white" data-theme="light">
    <div class="container narrow">
      <p class="label">In sixty seconds</p>
      <p class="p-summary" data-light-up>{p.summary}</p>
    </div>
  </section>

  <Highlights items={p.highlights} hue={p.slug} />

  <section class="section p-proof" data-theme="light" style={hue}>
    <div class="container">
      <p class="eyebrow gradient-text">Measured, not asserted</p>
      <h2 class="h2 p-proof-title" data-split>The numbers, with their method.</h2>
      <div class="p-stats" data-stagger>
        {p.metrics.map((m) => <div><Metric metric={m} /></div>)}
      </div>
    </div>
  </section>

  <section class="section-tight white" data-theme="light">
    <div class="container">
      <dl class="p-facts" data-stagger>
        {
          facts.map((f) => (
            <div>
              <dt class="label">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
        <div>
          <dt class="label">Stack</dt>
          <dd>{p.stack.join(' · ')}</dd>
        </div>
        <div>
          <dt class="label">Timeline</dt>
          <dd>Started {p.period.replace(' – present', '')}; this codebase since {p.codebaseSince}</dd>
        </div>
      </dl>
    </div>
  </section>

  <article class="case white" data-theme="light" style={hue}>
    <div class="container case-body">
      <slot />
    </div>
  </article>

  <section class="next-wrap" data-theme="light">
    <div class="container">
      <a class={`next-card next-${next.slug}`} href={next.caseStudy} data-theme={next.theme} style={`--g1: var(--${next.slug}); --g2: var(--${next.slug}-2)`}>
        <span class="label">Next case study</span>
        <span class="next-name">{next.name}</span>
        <span class="next-tag gradient-text">{next.tagline}.</span>
        <span class="next-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .p-hero {
    position: relative;
    overflow: clip;
    padding-top: calc(var(--nav-h) + clamp(40px, 6vw, 80px));
  }
  .p-hero-aether {
    background: radial-gradient(70% 60% at 80% 0%, rgba(255, 122, 47, 0.32), transparent 65%),
      radial-gradient(60% 50% at 0% 60%, rgba(255, 181, 71, 0.12), transparent 70%), #0c0806;
  }
  .p-hero-darkhorse {
    background: radial-gradient(70% 60% at 85% 0%, rgba(255, 77, 94, 0.2), transparent 65%),
      radial-gradient(60% 50% at 0% 70%, rgba(255, 154, 139, 0.16), transparent 70%), #fff7f6;
  }
  .p-hero-fintrust {
    background: radial-gradient(70% 60% at 85% 0%, rgba(19, 196, 143, 0.2), transparent 65%),
      radial-gradient(60% 50% at 0% 70%, rgba(79, 209, 255, 0.16), transparent 70%), #f2fbf7;
  }
  .back {
    display: inline-block;
    margin-bottom: 20px;
    font-size: 0.92rem;
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--ink);
  }
  .p-tagline {
    margin: 16px 0 26px;
    max-width: 30ch;
    font-size: clamp(1.3rem, 2.2vw, 1.85rem);
    color: var(--ink);
    font-weight: 560;
  }
  .repo-private {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 50px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 0.92rem;
    color: var(--muted);
    box-shadow: inset 0 0 0 1.5px var(--rule);
  }
  .lock {
    width: 12px;
    height: 10px;
    border-radius: 2px;
    background: currentColor;
    position: relative;
    margin-top: 4px;
  }
  .lock::before {
    content: '';
    position: absolute;
    left: 2px;
    top: -6px;
    width: 8px;
    height: 8px;
    border: 1.5px solid currentColor;
    border-bottom: 0;
    border-radius: 5px 5px 0 0;
    box-sizing: border-box;
  }
  .p-hero-media {
    margin-top: clamp(28px, 4vw, 52px);
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .p-summary {
    font-size: clamp(1.7rem, 3.6vw, 3rem);
    line-height: 1.16;
    letter-spacing: -0.032em;
    font-weight: 630;
    color: var(--ink);
    margin-top: 16px;
  }
  .p-proof-title {
    max-width: 14ch;
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  .p-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
  .p-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 40px;
    margin: 0;
    padding: 32px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 860px) {
    .p-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .p-facts {
      grid-template-columns: 1fr;
    }
  }
  .p-facts dd {
    margin: 8px 0 0;
    font-size: 1.02rem;
    color: var(--ink);
  }
  .case {
    padding-block: clamp(32px, 6vw, 80px) clamp(24px, 4vw, 48px);
  }
  .next-wrap {
    padding: 0 0 clamp(64px, 9vw, 120px);
  }
  .next-card {
    position: relative;
    display: grid;
    gap: 10px;
    padding: clamp(32px, 5vw, 64px);
    border-radius: var(--r-xl);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.6s var(--ease);
  }
  .next-card:hover {
    transform: translateY(-4px);
  }
  .next-aether {
    background: radial-gradient(70% 90% at 90% 0%, rgba(255, 122, 47, 0.34), transparent 65%), #110c09;
  }
  .next-darkhorse {
    background: radial-gradient(70% 90% at 90% 0%, rgba(255, 77, 94, 0.22), transparent 65%), #fff2f1;
  }
  .next-fintrust {
    background: radial-gradient(70% 90% at 90% 0%, rgba(19, 196, 143, 0.22), transparent 65%), #eaf8f2;
  }
  .next-name {
    font-size: clamp(2.6rem, 6vw, 5rem);
    line-height: 1;
    font-weight: 680;
    letter-spacing: -0.045em;
    color: var(--ink);
  }
  .next-tag {
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    font-weight: 600;
  }
  .next-arrow {
    position: absolute;
    right: clamp(28px, 4vw, 56px);
    bottom: clamp(28px, 4vw, 56px);
    font-size: 2rem;
    color: var(--ink);
    transition: transform 0.5s var(--ease);
  }
  .next-card:hover .next-arrow {
    transform: translateX(8px);
  }
  @media (max-width: 860px) {
    .p-stats {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  /* Long-form case-study content (the slot). */
  .case-body {
    max-width: 1040px;
  }
  .case .chapter {
    padding-block: clamp(40px, 6vw, 80px);
    border-top: 1px solid var(--rule);
  }
  .case .chapter:first-child {
    border-top: 0;
  }
  .case .kicker {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-accent, var(--muted));
    margin: 0 0 14px;
  }
  .case .chapter > h2 {
    font-size: clamp(1.9rem, 3.6vw, 3.1rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    font-weight: 660;
    max-width: 22ch;
    margin-bottom: 22px;
  }
  .case .prose {
    max-width: 66ch;
    font-size: 1.1rem;
    line-height: 1.68;
    color: var(--text);
  }
  .case .prose p {
    margin: 0 0 1.1em;
  }
  .case .prose strong {
    color: var(--ink);
  }
  .case .prose ul {
    padding-left: 1.2em;
    margin: 0 0 1.1em;
  }
  .case .prose li {
    margin-bottom: 0.5em;
  }
  .case blockquote {
    margin: 28px 0;
    padding: 4px 0 4px 22px;
    border-left: 3px solid var(--g1, var(--accent));
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
    font-weight: 560;
    color: var(--ink);
  }
  .case .callout {
    margin: 32px 0;
    padding: clamp(24px, 4vw, 44px);
    border-radius: var(--r-lg);
    background: #0b0b0d;
    color: #e8e8ed;
    --ink: #f5f5f7;
    --text: #e8e8ed;
    --muted: #a1a1a6;
    --rule: rgba(255, 255, 255, 0.14);
    position: relative;
    overflow: hidden;
  }
  .case .callout::before {
    content: '';
    position: absolute;
    width: 320px;
    height: 320px;
    right: -100px;
    top: -120px;
    border-radius: 50%;
    background: var(--g1, var(--accent));
    filter: blur(90px);
    opacity: 0.35;
  }
  .case .callout > * {
    position: relative;
  }
  .case .callout h3 {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    letter-spacing: -0.028em;
    margin: 0 0 14px;
    max-width: 26ch;
  }
  .case .callout p {
    color: #c7c7cc;
    max-width: 62ch;
  }
  .case .formula {
    margin: 22px 0;
    padding: 20px 22px;
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.06);
    font-family: var(--mono);
    font-size: clamp(0.78rem, 1.3vw, 0.92rem);
    line-height: 1.8;
    color: #f5f5f7;
    overflow-x: auto;
    white-space: pre;
  }
  .case .formula .ok {
    color: var(--fintrust-2);
  }
  .case .formula .no {
    color: var(--aether-2);
  }
  .case .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin: 28px 0 8px;
  }
  .case .tile {
    padding: 22px;
    border-radius: var(--r-md);
    background: var(--bg);
    box-shadow: 0 0 0 1px var(--rule);
  }
  .case .tile h3 {
    font-size: 1.08rem;
    letter-spacing: -0.015em;
    margin: 6px 0 8px;
  }
  .case .tile p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.55;
  }
  .case .tile .label {
    color: var(--ink-accent, var(--muted));
  }
  .case .numbers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 16px 28px;
    margin: 24px 0 8px;
  }
  .case .numbers b {
    display: block;
    font-family: var(--mono);
    font-weight: 500;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .case .numbers span {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .case .defects {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    gap: 0;
    counter-reset: d;
  }
  .case .defects li {
    counter-increment: d;
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 16px;
    padding: 18px 0;
    border-top: 1px solid var(--rule);
  }
  .case .defects li::before {
    content: counter(d, decimal-leading-zero);
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--ink-accent, var(--muted));
    padding-top: 3px;
  }
  .case .defects strong {
    color: var(--ink);
  }
  .case .defects p {
    margin: 4px 0 0;
    color: var(--muted);
  }
  .case figure.flow {
    margin-top: 28px;
  }
</style>
