---
// Custom cursor: a dot and a trailing ring that grows over links. Desktop pointers only.
---
<div class="cursor" data-cursor-root aria-hidden="true">
  <div class="cursor-ring"></div>
  <div class="cursor-dot"></div>
</div>

<style is:global>
  .cursor {
    display: none;
  }
  .has-cursor .cursor {
    display: block;
  }
  .cursor > div {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 9999;
    pointer-events: none;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .cursor.is-visible > div {
    opacity: 1;
  }
  .cursor-dot {
    width: 6px;
    height: 6px;
    background: #fff;
    mix-blend-mode: difference;
  }
  .cursor-ring {
    width: 34px;
    height: 34px;
    border: 1.5px solid #fff;
    mix-blend-mode: difference;
    transition:
      width 0.45s var(--ease),
      height 0.45s var(--ease),
      background-color 0.35s,
      border-color 0.35s,
      opacity 0.3s;
  }
  .cursor.is-link .cursor-ring {
    width: 56px;
    height: 56px;
    background: rgba(255, 255, 255, 0.12);
  }
  .cursor.is-down .cursor-ring {
    width: 26px;
    height: 26px;
  }
</style>
