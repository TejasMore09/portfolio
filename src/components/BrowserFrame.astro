---
// A product screenshot in a minimal browser window. `vt` names the element for the
// card → page view-transition morph; `ratio` crops tall screenshots (from the top, or `position`).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  url?: string;
  vt?: string;
  ratio?: string;
  position?: string;
  dark?: boolean;
  priority?: boolean;
  sizes?: string;
}
const { image, alt, url, vt, ratio, position, dark = false, priority = false, sizes = '(max-width: 900px) 92vw, 760px' } =
  Astro.props;
const widths = [480, 760, 1040, 1360, 1600, 2200].filter((w) => w < image.width);
widths.push(Math.min(image.width, 2200));
const host = url ? new URL(url).host : undefined;
const style = [vt && `view-transition-name: ${vt}`, ratio && `--ratio: ${ratio}`, position && `--pos: ${position}`]
  .filter(Boolean)
  .join('; ');
---
<figure class:list={['frame', { 'frame-dark': dark, 'frame-crop': !!ratio }]} style={style || undefined}>
  <div class="frame-bar" aria-hidden="true">
    <i></i><i></i><i></i>
    {host && <span class="frame-url">{host}</span>}
  </div>
  <div class="frame-body">
    <Image
      src={image}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </div>
</figure>

<style>
  .frame {
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.07),
      var(--shadow);
  }
  .frame-dark {
    background: #18130f;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.07),
      var(--shadow);
  }
  .frame-bar {
    height: 34px;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 14px;
    background: #f1f1f4;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  .frame-dark .frame-bar {
    background: #221b16;
    border-color: rgba(255, 255, 255, 0.06);
  }
  .frame-bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d1d1d6;
  }
  .frame-dark .frame-bar i {
    background: #4a3f37;
  }
  .frame-url {
    margin-inline: auto;
    transform: translateX(-24px);
    font: 500 0.72rem/1 var(--mono);
    color: #636366;
    background: rgba(0, 0, 0, 0.045);
    padding: 5px 14px;
    border-radius: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 60%;
  }
  .frame-dark .frame-url {
    color: #a1a1a6;
    background: rgba(255, 255, 255, 0.06);
  }
  .frame-crop .frame-body {
    aspect-ratio: var(--ratio);
    overflow: hidden;
  }
  .frame-crop .frame-body img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, top center);
  }
  .frame-body img {
    width: 100%;
  }
</style>
