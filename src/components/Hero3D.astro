---
// Canvas for the WebGL prism (src/scripts/prism.ts). The CSS fallback underneath is what
// visitors see first, and all they see without WebGL.
---
<div class="prism-fallback" aria-hidden="true"></div>
<canvas class="prism-canvas" data-prism aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-prism]');
  if (canvas) {
    const start = () =>
      import('../scripts/prism')
        .then((m) => m.mountPrism(canvas))
        .catch(() => {});
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 });
    else setTimeout(start, 250);
  }
</script>

<style>
  .prism-fallback,
  .prism-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .prism-fallback {
    background:
      radial-gradient(28% 34% at 72% 50%, rgba(110, 130, 255, 0.22), transparent 70%),
      linear-gradient(118deg, transparent 58%, rgba(255, 181, 71, 0.16) 66%, transparent 70%),
      linear-gradient(126deg, transparent 60%, rgba(255, 77, 94, 0.16) 68%, transparent 72%),
      linear-gradient(134deg, transparent 62%, rgba(46, 230, 166, 0.14) 70%, transparent 74%),
      linear-gradient(180deg, #03040a, #0a0c18);
  }
  .prism-canvas {
    opacity: 0;
    transition: opacity 1.8s var(--ease);
  }
  .prism-canvas:global(.is-ready) {
    opacity: 1;
  }
</style>
