---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, totalTests } from '../../data/projects';
---
<Base title="Work · Tejas More" description="Three deployed AI systems, built solo: Aether, DarkHorse AI and Fintrust.">
  <PageHero
    eyebrow="Work"
    title="Three systems. All live."
    lead={`Built solo, end to end — ${totalTests.toLocaleString('en-US')} tests between them. Each one is live, and each case study shows the numbers with the method behind them.`}
    hues={['var(--aether)', 'var(--darkhorse)']}
  />
  <section class="section-tight" data-theme="light">
    <div class="container stack">
      {projects.map((p, i) => <ProjectCard project={p} index={i} level={2} stack />)}
    </div>
  </section>
</Base>

<style>
  .stack {
    display: grid;
    gap: clamp(24px, 4vh, 48px);
    padding-bottom: clamp(48px, 8vw, 96px);
  }
</style>
