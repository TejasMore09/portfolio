---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import desk from '../assets/me/desk-1.jpg';
import ibm from '../assets/me/ibm-think.jpg';

const timeline = [
  { when: 'Apr 2026 →', what: 'Fintrust', detail: 'Citation-grounded regulatory intelligence for Indian finance — live.', href: '/work/fintrust' },
  { when: 'Mar 2026 →', what: 'DarkHorse AI', detail: 'Anti-fraud verdicts that show their evidence — live.', href: '/work/darkhorse' },
  { when: 'Nov 2025 →', what: 'Aether', detail: 'An AI agent that decides whether acting is worth the money — live.', href: '/work/aether' },
  { when: '2025', what: 'Elevate Labs', detail: 'AI & ML internship and DevOps internship (remote).' },
  { when: '2024 – 2025', what: 'IBM Think, Mumbai', detail: 'Tech volunteer at IBM’s flagship event.' },
  { when: '2023 – 2026', what: 'TransStadia Institute, Mumbai', detail: 'B.Sc. in Artificial Intelligence & Sports Analytics — CGPA 9.71.' },
  { when: '2021 – 2023', what: 'Patkar College of Arts and Science', detail: 'Science (PCM + Electronics).' },
];

const toolkit = [
  { group: 'AI / ML', items: ['RAG', 'Embeddings', 'pgvector', 'Gemini API', 'Claude', 'NLP', 'Sentence Transformers', 'LLM evaluation'] },
  { group: 'Languages', items: ['Python', 'TypeScript', 'JavaScript', 'SQL', 'Java'] },
  { group: 'Engineering', items: ['Data structures & algorithms', 'Object-oriented design', 'Low-level design', 'Testing & CI'] },
  { group: 'Frameworks', items: ['FastAPI', 'Next.js', 'React', 'SQLAlchemy', 'Express'] },
  { group: 'Data', items: ['PostgreSQL', 'MongoDB', 'MySQL', 'ChromaDB'] },
  { group: 'Platform', items: ['Docker', 'GitHub Actions', 'Vercel', 'Render', 'Neon', 'OAuth 2.0'] },
];

const principles = [
  { title: 'A number ships with its method.', body: 'DarkHorse publishes its false-positive rate with the count and the command that reproduces it — and withdrew one that didn’t.' },
  { title: 'Unchecked isn’t zero.', body: 'A check that couldn’t run says so. A score of zero from a skipped check looks exactly like a pass.' },
  { title: 'The model is never the last step.', body: 'Quotes are verified against the source; deadlines and decisions are computed by code.' },
  { title: 'Isolation belongs in the database.', body: 'Row-level security, proved with tests that fail if a policy is dropped.' },
];
---
<Base title="About · Tejas More" description={`${site.role} in ${site.location}. B.Sc. in Artificial Intelligence (CGPA 9.71). Three production AI systems, built solo.`}>
  <section class="about-hero grain" data-theme="dark">
    <div class="container hero-grid">
      <div class="intro">
        <p class="eyebrow gradient-text" style="--g1: var(--aether-2); --g2: var(--aether)">About</p>
        <h1 class="display">Hi, I’m Tejas.</h1>
        <p class="lead">
          An AI and software engineer in Mumbai. I build and deploy production AI systems and LLM applications end to end — and I care most
          about the part after the demo: making them <strong>reliable, secure and measurable</strong>.
        </p>
        <div class="cta-row">
          {site.resume && <a class="btn hero-btn" href={site.resume} data-magnetic>Download résumé</a>}
          <a class="btn btn-ghost" href={`mailto:${site.email}`}>Email me</a>
        </div>
      </div>
      <div class="hero-photo intro">
        <Image src={desk} alt="Tejas working at his desk at night, lit by a ring lamp" widths={[480, 760, 920]} sizes="(max-width: 900px) 90vw, 480px" loading="eager" />
      </div>
    </div>
  </section>

  <section class="section white" data-theme="light">
    <div class="container narrow">
      <p class="label">What I’m like to work with</p>
      <p class="statement" data-light-up>
        I’d rather publish a smaller number I can reproduce than a better one I can’t. Every system I’ve shipped says what it
        couldn’t check, cites what it claims, and keeps a person in charge of what can’t be undone.
      </p>
    </div>
  </section>

  <section class="section" data-theme="light">
    <div class="container">
      <p class="eyebrow">The path so far</p>
      <h2 class="h2" data-split>From PCM to production AI.</h2>
      <ol class="timeline" data-stagger>
        {
          timeline.map((t) => (
            <li>
              <span class="when mono">{t.when}</span>
              <div>
                <h3 class="h3">{t.href ? <a href={t.href}>{t.what} →</a> : t.what}</h3>
                <p>{t.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section-tight ibm" data-theme="dark">
    <div class="container ibm-grid">
      <div class="ibm-photo" data-reveal>
        <Image src={ibm} alt="Tejas at IBM Think, in front of the IBM backdrop, giving a thumbs up" widths={[400]} sizes="320px" />
      </div>
      <div>
        <p class="eyebrow gradient-text" style="--g1: var(--blue); --g2: #9ab8ff">IBM Think · 2024 – 2025</p>
        <h2 class="h2" data-split>Tech volunteer at IBM’s flagship event.</h2>
      </div>
    </div>
  </section>

  <section class="section white" data-theme="light">
    <div class="container">
      <p class="eyebrow">Toolkit</p>
      <h2 class="h2" data-split>What I build with.</h2>
      <div class="toolkit" data-stagger>
        {
          toolkit.map((t) => (
            <div class="tk">
              <span class="label">{t.group}</span>
              <ul>
                {t.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section principles grain" data-theme="dark">
    <div class="container">
      <p class="eyebrow gradient-text" style="--g1: var(--fintrust-2); --g2: var(--fintrust)">How I work</p>
      <h2 class="h2" data-split>Four rules I keep.</h2>
      <div class="rules" data-stagger>
        {
          principles.map((r, i) => (
            <div class="rule">
              <span class="label">0{i + 1}</span>
              <h3 class="h3">{r.title}</h3>
              <p>{r.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .about-hero {
    position: relative;
    overflow: clip;
    padding: calc(var(--nav-h) + clamp(64px, 10vw, 130px)) 0 clamp(64px, 9vw, 120px);
    background: radial-gradient(60% 70% at 85% 30%, rgba(255, 170, 80, 0.16), transparent 70%), #0d0a08;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .lead {
    margin: 26px 0 32px;
  }
  .hero-btn {
    background: #f5f5f7;
    color: #000;
  }
  .hero-photo {
    border-radius: var(--r-xl);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    box-shadow: var(--shadow);
  }
  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 35%;
  }
  .statement {
    font-size: clamp(1.8rem, 4vw, 3.3rem);
    line-height: 1.14;
    letter-spacing: -0.034em;
    font-weight: 640;
    color: var(--ink);
    margin-top: 16px;
  }
  .timeline {
    list-style: none;
    padding: 0;
    margin: clamp(32px, 5vw, 56px) 0 0;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--rule);
  }
  .when {
    color: var(--muted);
    font-size: 0.86rem;
    padding-top: 6px;
  }
  .timeline h3 a {
    text-decoration: none;
  }
  .timeline h3 a:hover {
    color: var(--accent);
  }
  .timeline p {
    margin: 6px 0 0;
    color: var(--muted);
  }
  .ibm {
    background: radial-gradient(60% 80% at 20% 50%, rgba(47, 107, 255, 0.2), transparent 70%), #05070d;
  }
  .ibm-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .ibm-photo {
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .toolkit {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    margin-top: clamp(32px, 5vw, 56px);
  }
  @media (max-width: 860px) {
    .toolkit {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .toolkit {
      grid-template-columns: 1fr;
    }
  }
  .tk ul {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tk li {
    padding: 7px 13px;
    border-radius: 999px;
    font-size: 0.92rem;
    background: var(--panel);
    color: var(--ink);
  }
  .principles {
    background: #000;
    padding-bottom: clamp(72px, 8vw, 112px);
  }
  .rules {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: clamp(32px, 5vw, 56px);
  }
  .rule {
    padding: 26px;
    border-radius: var(--r-lg);
    background: #111113;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
  }
  .rule h3 {
    margin: 10px 0;
  }
  .rule p {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .hero-grid,
    .ibm-grid,
    .rules {
      grid-template-columns: 1fr;
    }
    .timeline li {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .ibm-photo {
      max-width: 320px;
    }
  }
</style>
